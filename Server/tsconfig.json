{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "allowJs": false,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "rootDir": "..",
    "outDir": "dist",
    "types": ["node", "jest"]
  },
  "include": ["**/*.ts", "../Shared/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
